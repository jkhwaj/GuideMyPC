{
    "name": "jkhwaj/guidemypc",
    "description": "Consumer technology support application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "GuideMyPC\\": "app/"
        }
    },
    "scripts": {
        "verify:fast": [
            "@composer validate --strict",
            "@php scripts/lint.php",
            "@php tests/helpers_test.php"
        ],
        "verify": [
            "@verify:fast",
            "@php scripts/verify.php"
        ],
        "package:submission": "@php scripts/package-submission.php --output=build/GuideMyPC_Submission.zip --force",
        "package:submission:strict": "@php scripts/package-submission.php --output=build/GuideMyPC_Submission.zip --force --strict"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

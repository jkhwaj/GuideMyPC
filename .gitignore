# Local environment and secrets
.env
.env.*
!.env.example

# Runtime and local data
/logs/
/uploads/
/storage/
/database/backups/
*.log
*.sql.gz
*.bak

# Dependencies and test output
/vendor/
/node_modules/
/coverage/
/.phpunit.cache/

# Generated packages
/build/
/release/
*.zip

# Final submission binaries stay local
/docs/submission/documents/*
!/docs/submission/documents/README.md
/docs/submission/screenshots/*
!/docs/submission/screenshots/README.md
/uml/source/*
!/uml/source/README.md
/uml/exports/*
!/uml/exports/README.md

# IDE and operating-system files
/.idea/
/.vscode/
*.code-workspace
Thumbs.db
Desktop.ini
.DS_Store

# Local development tooling
/opencode.json
/.code-review-graph/
*.pdf

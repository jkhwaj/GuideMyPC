# Local development values only. Copy to a private .env; do not commit it.
# A managed host may inject the same names as process environment variables.
APP_ENV=local
# An explicit value is authoritative. The generated source-package template leaves this blank for localhost/<folder> detection.
APP_URL=http://guidemypc.test
# Increment this when deployment changes static CSS or JavaScript assets.
APP_ASSET_VERSION=1
# Leave unset to use C:\xampp\guidemypc-private, outside Apache's document root.
# APP_PRIVATE_PATH=C:\xampp\guidemypc-private
# Required for HTTPS deployments. Leave false locally unless local HTTPS is configured.
SESSION_COOKIE_SECURE=false
# Leave blank for host-only cookies. Set only to an approved shared parent domain.
# SESSION_COOKIE_DOMAIN=
# Required in production. Store this high-entropy value in the host secret manager.
# REMEMBER_TOKEN_PEPPER=
# Persistent-browser sign-in is optional and bounded by these values.
REMEMBER_DEVICE_DAYS=30
REMEMBER_DEVICE_LIMIT=5

# These match the current local XAMPP prototype defaults. Use a dedicated local
# database user when available. The application reads this file at runtime.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=guidemypc
# Required by integration tests. It must be a dedicated database ending in _test.
DB_TEST_NAME=guidemypc_test
DB_USER=root
DB_PASSWORD=

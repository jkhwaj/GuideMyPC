# Local development values only. Copy to .env; do not commit .env.
APP_ENV=local
# An explicit value is authoritative. The generated source-package template leaves this blank for localhost/<folder> detection.
APP_URL=http://guidemypc.test
# Increment this when deployment changes static CSS or JavaScript assets.
APP_ASSET_VERSION=1
# Leave unset to use C:\xampp\guidemypc-private, outside Apache's document root.
# APP_PRIVATE_PATH=C:\xampp\guidemypc-private

# These match the current local XAMPP prototype defaults. Use a dedicated local
# database user when available. The application reads this file at runtime.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=guidemypc
# Required by integration tests. It must be a dedicated database ending in _test.
DB_TEST_NAME=guidemypc_test
DB_USER=root
DB_PASSWORD=
